{
  "manifest_version": 3,
  "name": "Extended Custom Tab",
  "version": "1.1",
  "description": "Стартовая страница с неограниченным количеством ярлыков",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "favicon"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
