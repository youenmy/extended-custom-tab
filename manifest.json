{
  "manifest_version": 3,
  "name": "Extended Custom Tab",
  "version": "2.0",
  "description": "Стартовая страница с неограниченным количеством ярлыков, заметками, календарём и почтой",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "favicon"],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://mail.google.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
